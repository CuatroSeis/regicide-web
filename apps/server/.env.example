# Puerto del server (default: 3001)
PORT=3001

# Origin del frontend para CORS (solo en dev con Vite separado)
CLIENT_ORIGIN=http://localhost:5173

# Directorio del build estático de la web (default: ../../web/dist)
# PUBLIC_DIR=../../web/dist

# Supabase (para auth)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_TU_KEY

# PostgreSQL (para tabla de posiciones; si no existe, usa archivo JSON local)
# DATABASE_URL=postgresql://usuario:password@host:puerto/dbname

# Archivo JSON fallback para leaderboard (si no hay DATABASE_URL)
# LEADERBOARD_FILE=../../data/leaderboard.json
